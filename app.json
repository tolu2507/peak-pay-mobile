{
  "expo": {
    "name": "PeakPay",
    "slug": "peak-pay",
    "owner": "peakpay-org",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "peakpay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.peakpay.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF7A00",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.peakpay.app",
      "icon": "./assets/images/icon.png",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./withMLKitDependencies.js",
      "./withKotlinCompat.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF7A00",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FF7A00",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow PeakPay to use Face ID so you can sign in quickly and securely."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PeakPay to access your photos so you can set a profile picture.",
          "cameraPermission": "Allow PeakPay to use your camera to verify your identity with a selfie and to take a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2edc903d-a8bd-4395-8684-45b44cf6ffde"
      }
    }
  }
}
